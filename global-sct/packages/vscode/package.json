{
  "name": "sct-vscode",
  "displayName": "global.sct",
  "description": "Show global.sct secret metadata and open a terminal with project secrets.",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.145.0" },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "sct.showStatus", "title": "Show global.sct status" },
      { "command": "sct.refreshSecrets", "title": "Refresh global.sct secrets", "icon": "$(refresh)" },
      { "command": "sct.openTerminal", "title": "Open terminal with global.sct secrets" }
    ],
    "views": {
      "explorer": [{ "id": "sct.secrets", "name": "global.sct secrets" }]
    },
    "menus": {
      "view/title": [{ "command": "sct.refreshSecrets", "when": "view == sct.secrets", "group": "navigation" }]
    }
  }
}
