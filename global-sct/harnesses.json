[
  {
    "id": "opencode",
    "displayName": "OpenCode",
    "binary": "opencode",
    "installHint": "npm install -g @opencode/cli",
    "knownVersion": "2.2.6",
    "versionArgs": ["--version"],
    "helpArgs": ["run", "--help"],
    "requiredHelpTokens": ["--format", "--model"],
    "defaultProtocol": "acp-stdio",
    "acp": { "mode": "native", "command": "opencode", "args": ["acp"] },
    "headless": { "argsTemplate": ["run", "--format", "json", "{prompt}"], "output": "json" },
    "env": {
      "cloud": { "OPENCODE_CONFIG_CONTENT": { "json": { "model": "{model}" } } },
      "lemonadeLocal": {
        "OPENCODE_CONFIG_CONTENT": { "json": {
          "provider": { "lemonade": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Lemonade",
            "options": { "baseURL": "{baseUrl}", "apiKey": "lemonade" },
            "models": { "{model}": { "name": "{model}" } }
          } },
          "model": "lemonade/{model}"
        } }
      }
    },
    "lemonadeArgs": [],
    "lemonadeBaseUrlStyle": "openai-v1",
    "instruction": { "fileName": "AGENTS.md", "args": [] },
    "mcp": {
      "method": "env-config",
      "argsTemplate": [],
      "env": { "OPENCODE_CONFIG_CONTENT": { "json": { "mcp": { "lemon-tree": { "type": "remote", "url": "{mcpUrl}" } } } } }
    },
    "unverified": ["env.lemonadeLocal.OPENCODE_CONFIG_CONTENT.provider", "mcp.env.OPENCODE_CONFIG_CONTENT.mcp"],
    "license": "MIT",
    "benefits": {
      "autonomy": "high",
      "tokenEfficiency": "medium",
      "diffStrategy": "search-replace",
      "subagentSupport": true,
      "lspIntegration": true,
      "localModelFriendly": true,
      "bestFor": ["LSP-checked refactors", "any OpenAI-compatible or local model"],
      "tradeoffs": "Model quality decides results; config is JSON-heavy."
    }
  },
