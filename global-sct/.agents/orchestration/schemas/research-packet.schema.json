{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lemon-tree/orc/research-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packetId",
    "question",
    "route",
    "tree",
    "claims",
    "openQuestions"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "packetId": {
      "type": "string",
      "pattern": "^RP-[0-9]{4}$"
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerInstanceId",
        "model"
      ],
      "properties": {
        "providerInstanceId": {
          "const": "antigravity"
        },
        "model": {
          "enum": [
            "gemini-4-hydrogen",
            "gemini-3.8-flash"
          ]
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "agtop",
        "toolkit"
      ],
      "description": "The commits the agent read. Gate R checks each claim against these exact commits.",
      "properties": {
        "workspace": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "agtop": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "toolkit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "class",
          "risk",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]{1,3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "class": {
            "enum": [
              "VERIFIED_IN_CODE",
              "INFERRED_FROM_DOCS",
              "EXTERNAL_SPEC_ASSUMPTION"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "repo",
                    "path",
                    "startLine",
                    "endLine",
                    "sha256",
                    "snippet"
                  ],
                  "properties": {
                    "kind": {
                      "const": "code"
                    },
                    "repo": {
                      "enum": [
                        "workspace",
                        "agtop",
                        "toolkit"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^[^/].*[^/]$"
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "SHA-256 of the exact bytes of lines startLine..endLine, joined with \\n, no final newline."
                    },
                    "snippet": {
                      "type": "string",
                      "maxLength": 4000,
                      "description": "The same lines, verbatim."
                    },
                    "symbols": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*$"
                      },
                      "maxItems": 8
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "url",
                    "retrievedAt",
                    "quote"
                  ],
                  "properties": {
                    "kind": {
                      "const": "external"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "retrievedAt": {
                      "type": "string",
                      "format": "date"
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  }
                }
              ]
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C[0-9]{1,3}$"
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
